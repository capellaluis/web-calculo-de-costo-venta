# Byte-compiled / optimized / DLL files (Python)
_pycache_/
*.pyc
*$py.class

# Entorno virtual
venv/
.venv/
env/

# Variables de entorno y secretos (¡NUNCA subir a Git!)
.env
.secret_key

# Archivos de base de datos local (si usas SQLite)
*.sqlite3
*.db

# Directorio de pruebas y cobertura
.pytest_cache/
htmlcov/
.coverage

# Archivos del sistema u IDEs
.vscode/
.idea/
.DS_Store

# Claude Code: se versionan las skills (.skills/ y el symlink .claude/skills),
# no la configuración personal ni archivos de estado
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Logos y archivos subidos por el usuario
static/uploads/

# Excel exportado y copias de seguridad de la base
exports/
backups/
INSTALL_TOKEN.txt
