<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block titulo %}Panel principal{% endblock %} · Mi Negocio</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='icons/bootstrap-icons.css') }}">
  <link rel="stylesheet" href="{{ url_for('static', filename='css/estilo.css') }}">
</head>
<body>

<nav class="menu">
  <a class="marca" href="{{ url_for('dashboard.inicio') }}">
    <div class="logo"><i class="bi bi-shop"></i></div>
    <span>Mi Negocio</span>
  </a>

  <div class="menu-titulo">Principal</div>
  <a class="nav-item c-dashboard{{ ' activo' if seccion == 'dashboard' }}" href="{{ url_for('dashboard.inicio') }}">
    <i class="bi bi-house-door-fill"></i><span>Panel principal</span>
  </a>
  <a class="nav-item c-proveedores{{ ' activo' if seccion == 'proveedores' }}" href="#">
    <i class="bi bi-people-fill"></i><span>Proveedores</span>
  </a>
  <a class="nav-item c-compras{{ ' activo' if seccion == 'compras' }}" href="#">
    <i class="bi bi-cart-fill"></i><span>Compras</span>
  </a>
  <a class="nav-item c-productos{{ ' activo' if seccion == 'productos' }}" href="#">
    <i class="bi bi-box-seam-fill"></i><span>Productos</span>
  </a>

  <div class="menu-titulo">Producción</div>
  <a class="nav-item c-recetas{{ ' activo' if seccion == 'recetas' }}" href="#">
    <i class="bi bi-egg-fried"></i><span>Recetas</span>
  </a>
  <a class="nav-item c-costos{{ ' activo' if seccion == 'costos' }}" href="#">
    <i class="bi bi-calculator-fill"></i><span>Costos</span>
  </a>

  <div class="menu-titulo">Sistema</div>
  <a class="nav-item c-reportes{{ ' activo' if seccion == 'reportes' }}" href="#">
    <i class="bi bi-bar-chart-fill"></i><span>Reportes</span>
  </a>
  <a class="nav-item c-compras{{ ' activo' if seccion == 'excel' }}" href="#">
    <i class="bi bi-file-earmark-excel-fill"></i><span>Excel</span>
  </a>
  <a class="nav-item c-config{{ ' activo' if seccion == 'config' }}" href="#">
    <i class="bi bi-gear-fill"></i><span>Configuración</span>
  </a>
</nav>

<main class="contenido c-{{ seccion|default('dashboard') }}">
  {% block contenido %}{% endblock %}
</main>

{% block scripts %}{% endblock %}
</body>
</html>
{# FIN base.html #}
