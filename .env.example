# =====================================================
# MI NEGOCIO - Configuracion local
# Los scripts de instalacion copian este archivo como ".env"
# y generan una SECRET_KEY nueva automaticamente.
# NUNCA subas el archivo .env a Git.
# =====================================================

# Clave secreta de la aplicacion (se genera sola al instalar).
SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_ALEATORIA

# Direccion donde escucha el servidor:
#   127.0.0.1 -> solo esta computadora (recomendado en Windows / PC personal)
#   0.0.0.0   -> visible para otros equipos de la red Wi-Fi
#                (usalo en la Raspberry Pi para entrar desde telefono o tablet)
APP_HOST=127.0.0.1

# Puerto donde se abre la aplicacion: http://127.0.0.1:5000
APP_PORT=5000

# Modo desarrollo:
#   1 -> recarga sola al editar codigo y muestra errores detallados
#   0 -> modo normal (recomendado para uso diario)
# IMPORTANTE: no uses APP_DEBUG=1 junto con APP_HOST=0.0.0.0 fuera de una red de confianza.
APP_DEBUG=0
